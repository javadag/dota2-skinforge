{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "src/data/**/*",
    "scripts/**/*",
    "test/**/*",
    // The armory resolver and the set hydration live in the renderer but are unit tested
    // from `test/`; listing them (and what they import) here keeps those tests inside the
    // type check.
    "src/renderer/components/slotGenerator.ts",
    "src/renderer/utils/heroSets.ts",
    "src/renderer/utils/itemImages.ts",
    "src/renderer/env.d.ts",
    "workers/**/*",
    "electron.vite.config.*",
    "package.json"
  ]
}
