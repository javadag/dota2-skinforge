{
  "name": "dota2-skinforge",
  "productName": "Dota 2 SkinForge",
  "shortName": "SkinForge",
  "modFolder": "skinforge",
  "version": "1.1.0",
  "tagline": "Cosmetic Suite",
  "description": "Local Dota 2 cosmetic suite via VPK modding",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "restart": "taskkill /F /IM electron.exe 2>nul & electron-vite preview",
    "stop": "taskkill /F /IM electron.exe 2>nul",
    "build:win": "electron-vite build && electron-builder --win portable",
    "build:installer": "electron-vite build && electron-builder --win nsis",
    "dist": "electron-vite build && electron-builder --win portable",
    "dist:dir": "electron-vite build && electron-builder --dir",
    "sync:icons": "tsx scripts/sync_r2_icons.ts",
    "update:nonhero": "tsx scripts/build_nonhero_catalog.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{js,ts,css,html}\"",
    "format:check": "prettier --check \"src/**/*.{js,ts,css,html}\"",
    "typecheck": "tsc -b --noEmit",
    "test": "tsx test/services.test.js && tsx test/appPaths.test.js && tsx test/systemIpc.test.js && tsx test/modifier.test.js && tsx test/catalog.test.js && tsx test/shared.test.js && tsx test/iconCache.test.js && tsx test/itemImages.test.js && tsx test/settingsIpc.test.js && tsx test/syncCli.test.js && electron -r tsx/cjs test/electron-smoke.js",
    "prepare": "husky"
  },
  "keywords": [
    "dota2",
    "dota-2",
    "cosmetics",
    "skin-changer",
    "vpk",
    "vpk-modding",
    "electron",
    "source2",
    "arcana",
    "immortal",
    "persona",
    "game-modding",
    "steam",
    "local-mods",
    "dota2-tools",
    "electron-app",
    "react",
    "typescript"
  ],
  "author": "Joad",
  "license": "MIT",
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1148.0",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.3.7"
  },
  "lint-staged": {
    "*.{js,ts,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,html,md}": [
      "prettier --write"
    ]
  },
  "allowScripts": {
    "electron@33.4.11": true
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  }
}
