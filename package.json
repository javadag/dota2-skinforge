{
  "name": "dota2-skinforge",
  "productName": "Dota 2 SkinForge",
  "shortName": "SkinForge",
  "modFolder": "skinforge",
  "version": "1.0.0",
  "tagline": "Cosmetic Suite",
  "description": "Local Dota 2 cosmetic suite via VPK modding",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "restart": "taskkill /F /IM electron.exe 2>nul & electron .",
    "stop": "taskkill /F /IM electron.exe 2>nul",
    "dev": "electron . --dev",
    "build:icons": "node scripts/build_curated_item_pack.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{js,ts,css,html}\"",
    "format:check": "prettier --check \"src/**/*.{js,ts,css,html}\"",
    "prepare": "husky"
  },
  "keywords": [
    "dota2",
    "cosmetics",
    "vpk",
    "electron"
  ],
  "author": "Joad",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "electron": "^33.0.0",
    "electron-vite": "^5.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.3.7"
  },
  "lint-staged": {
    "*.{js,ts,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,html,md}": [
      "prettier --write"
    ]
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
